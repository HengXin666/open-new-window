{
  "name": "open-new-window",
  "displayName": "Open in New Window",
  "description": "在新的 VSCode 窗口中打开文件所在目录",
  "version": "0.0.9",
  "publisher": "HengXin666",
  "repository": {
    "type": "git",
    "url": "https://github.com/HengXin666/open-new-window"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "open-new-window.openParentInNewWindow",
        "title": "新窗口打开 (父目录)",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "open-new-window.openFolderInNewWindow",
        "title": "新窗口打开 (此目录)",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "open-new-window.openTerminalCwdInNewWindow",
        "title": "新窗口打开 (终端当前目录)",
        "icon": "$(multiple-windows)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "open-new-window.openParentInNewWindow",
          "when": "!explorerResourceIsFolder",
          "group": "navigation@99"
        },
        {
          "command": "open-new-window.openFolderInNewWindow",
          "when": "explorerResourceIsFolder",
          "group": "navigation@99"
        }
      ],
      "editor/title/context": [
        {
          "command": "open-new-window.openParentInNewWindow",
          "group": "navigation@99"
        }
      ],
      "terminal/title/context": [
        {
          "command": "open-new-window.openTerminalCwdInNewWindow",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.93.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
